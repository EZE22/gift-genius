# Copy this file to .env and fill in ONE of the three options below.
# Never put a real key in this file: it is committed to git.

# Option 1: Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-api-key-here

# Option 2: Microsoft Foundry. When ANTHROPIC_FOUNDRY_API_KEY is set, it is used instead of option 1.
# ANTHROPIC_FOUNDRY_API_KEY=your-foundry-key-here
# ANTHROPIC_FOUNDRY_BASE_URL=https://<your-resource>.services.ai.azure.com/anthropic
# ANTHROPIC_FOUNDRY_DEPLOYMENT=your-deployment-name

# Option 3: a local model through Ollama. No API key. Install Ollama, run `ollama pull qwen3:4b-instruct-2507-q4_K_M`, then set:
# MODEL_SOURCE=ollama
# Optional. Both have defaults. In a container or Kubernetes pod, set the address to the Ollama service, not localhost.
# OLLAMA_BASE_URL=http://localhost:11434
# Docker Compose already defaults the address to http://host.docker.internal:11434, which reaches Ollama on your Mac.
# Docker Compose only: the port the web app is published on, on 127.0.0.1. Default 8080.
# WEB_PORT=8080
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Optional: a fast model for the router (one call that returns one label).
# Claude API: a model id such as claude-haiku-5-5. Foundry: a deployment name.
# Leave empty to use the main model.
ROUTER_MODEL=
